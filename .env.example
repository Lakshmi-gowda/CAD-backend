# Environment Configuration
ENV=development
LOG_LEVEL=INFO

# Path to model artifacts directory
ARTIFACTS_DIR=backend/app/ml/artifacts

# Allowed CORS origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173

# Maximum accepted HTTP request body size
MAX_REQUEST_SIZE_BYTES=1048576

# Render supplies PORT automatically; do not set a fixed port here.
# Set ENV=production and CORS_ORIGINS to your frontend origin in Render's
# Environment settings. No third-party API keys or API base URLs are required.
#
# After deployment, replace <your-render-service> with the URL Render assigns:
# https://<your-render-service>.onrender.com/health/live
# https://<your-render-service>.onrender.com/health
# https://<your-render-service>.onrender.com/model-info
# https://<your-render-service>.onrender.com/predict
# https://<your-render-service>.onrender.com/docs
